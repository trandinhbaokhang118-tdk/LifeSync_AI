# Database (MySQL)
# Local Docker default: mysql://tm_user:tm_password@localhost:3306/time_manager
DATABASE_URL="mysql://tm_user:tm_password@localhost:3306/time_manager"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Render: https://time-manager-frontend.onrender.com
FRONTEND_URL="http://localhost:5173"
MOBILE_FRONTEND_URL="https://localhost"

# OpenAI API (for AI Chatbot - Optional)
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=""
PAYMENTS_ENABLED="false"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/auth/facebook/callback"
