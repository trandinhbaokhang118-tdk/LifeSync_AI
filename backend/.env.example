# Database (MySQL)
# Local Docker default: mysql://tm_user:tm_password@localhost:3306/lifesync_ai
DATABASE_URL="mysql://tm_user:tm_password@localhost:3306/lifesync_ai"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN="15m"
REFRESH_TOKEN_EXPIRES_IN="7d"
REMEMBER_ME_REFRESH_TOKEN_EXPIRES_IN="30d"
PASSWORD_RESET_TOKEN_EXPIRES_IN="1h"

# Server
HOST=0.0.0.0
PORT=3000
NODE_ENV=development

# OTP storage (optional)
# Leave empty to use the built-in in-memory store (single instance / dev).
# Set to a Redis connection string for shared, restart-safe, multi-instance
# OTP storage in production, e.g. redis://localhost:6379
# Requires the `ioredis` package (npm install ioredis).
REDIS_URL=""

# Email delivery for password-reset links (Resend)
# Create an API key at https://resend.com and use a verified sender address.
RESEND_API_KEY=""
EMAIL_FROM="LifeSync AI <no-reply@example.com>"

# SMS OTP delivery (Twilio). Phone numbers must use E.164 format, e.g. +849...
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_PHONE_NUMBER=""

# Frontend URL (for CORS)
# Local: http://localhost:5173
# Render: https://time-manager-frontend.onrender.com
FRONTEND_URL="http://localhost:5173"
MOBILE_FRONTEND_URL="https://localhost"

# Production Frontend URL (with Cloudflare)
# Example: https://lifesync-ai.com or https://www.lifesync-ai.com
PRODUCTION_FRONTEND_URL=""

# AI Chatbot provider config
# 9router: local OpenAI-compatible proxy (run `9router.bat`, default port 20128).
#   No API key needed - it authenticates upstream providers itself.
#   AI_MODEL uses 9router's prefixed ids, e.g. gh/gpt-5.4-mini, bb/gpt-4o-mini.
# OpenAI:    AI_BASE_URL="https://api.openai.com/v1"  + OPENAI_API_KEY="sk-..."
# OpenRouter:AI_BASE_URL="https://openrouter.ai/api/v1" + OPENAI_API_KEY="sk-or-..."
AI_BASE_URL="http://127.0.0.1:20128/v1"
AI_MODEL="gh/gpt-5.4-mini"
AI_PRIMARY_TIMEOUT_MS="12000"

# Optional - only needed for OpenAI / OpenRouter.
# Get your API key from: https://platform.openai.com/
OPENAI_API_KEY=""
AI_FALLBACK_BASE_URL=""
AI_FALLBACK_MODEL=""
AI_FALLBACK_API_KEY=""
AI_FALLBACK_TIMEOUT_MS="60000"

# AI abuse protection (requests per IP per 15 minutes)
RATE_LIMIT_AI_MAX="30"
PAYMENTS_ENABLED="false"

# Stripe Checkout subscriptions. Create recurring Prices in Stripe, then copy
# their price IDs here. Only set PAYMENTS_ENABLED=true after all three values
# are present and the Stripe success/cancel URLs point to this frontend.
STRIPE_SECRET_KEY=""
STRIPE_PRO_PRICE_ID=""
STRIPE_PLUS_PRICE_ID=""
STRIPE_WEBHOOK_SECRET=""

# SePay Payment Gateway (Production merchant IDs start with SP-LIVE-).
# Keep all SePay secrets only in backend/.env or the deployment secret store.
# Configure POST /payments/webhook/sepay as the IPN URL using the current
# public HTTPS/ngrok domain; the application does not call its own IPN URL.
SEPAY_ENVIRONMENT="production"
SEPAY_MERCHANT_ID="SP-LIVE-TD7A37B6"
SEPAY_MERCHANT_SECRET_KEY=""
SEPAY_IPN_SECRET_KEY=""
SEPAY_WEBHOOK_API_KEY=""
SEPAY_BANK_NAME="VietinBank"
SEPAY_BANK_ACCOUNT_NUMBER="105879514995"
SEPAY_BANK_ACCOUNT_NAME="TRAN DINH BAO KHANG"

# Google OAuth
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/auth/google/callback"

# Facebook OAuth
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
FACEBOOK_REDIRECT_URI="http://localhost:3000/auth/facebook/callback"
FACEBOOK_API_VERSION="v25.0"
